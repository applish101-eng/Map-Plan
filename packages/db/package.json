{
  "name": "@nepal-flood-gis/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "node scripts/migrate.mjs up",
    "migrate:status": "node scripts/migrate.mjs status",
    "migrate:down": "node scripts/migrate.mjs down",
    "verify": "psql \"$DATABASE_MIGRATOR_URL\" -v ON_ERROR_STOP=1 -f scripts/verify_migration.sql",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}