# pnpm configuration
#
# strict-dep-builds=false: pnpm 11 treats an unapproved build script as a fatal
# install error. sharp is a transitive dependency of Next.js (image
# optimisation), ships prebuilt per-platform binaries, and its install script is
# a no-op when a matching binary exists. Failing the whole install over it
# blocks work that does not use image processing at all, so the warning is
# allowed to be a warning. Dependencies that genuinely need a build are still
# gated by onlyBuiltDependencies in pnpm-workspace.yaml.
strict-dep-builds=false

# Workspace packages link rather than hoist, so each package only sees the
# dependencies it declares.
link-workspace-packages=true
prefer-workspace-packages=true

# Keep the store local to the project for reproducible installs.
store-dir=.pnpm-store

# Engine enforcement off for install; the app declares >=20.11 and Next 15
# requires 18.18+. Local Node 25 satisfies it.
engine-strict=false