# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://app_rw:nepal_dev_pw@localhost:5433/nepal_flood_gis
DATABASE_MIGRATOR_URL=postgresql://migrator:nepal_dev_pw@localhost:5433/nepal_flood_gis
DATABASE_TILES_URL=postgresql://tiles_ro:nepal_dev_pw@localhost:5433/nepal_flood_gis
POSTGRES_PORT=5433

# --- Map / basemap ----------------------------------------------------------
# Style JSON describing our layers. Local file or URL served by the app.
MAP_STYLE_URL=/styles/basemap-style.json
# Local PMTiles archive. Local-first: never point this at tile.openstreetmap.org in production.
PMTILES_URL=http://localhost:8080/data/nepal.pmtiles
# Development escape hatch to a permitted public raster source. MUST be false in production.
ENABLE_DEV_BASEMAP_FALLBACK=false

# --- Storage ----------------------------------------------------------------
# fs = local filesystem (dev) | s3 = S3/MinIO compatible (prod)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./data/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nepal-flood-gis
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Domain configuration ---------------------------------------------------
# Initial corridor extent. Configuration, never hard-coded (spec 1.4).
DEFAULT_EXTENT_DISTRICTS=Rasuwa,Nuwakot,Dhading,Chitwan
# UUID of the primary organisation row (Plan International) after seed.
PRIMARY_ORG_ID=
# Counts below this threshold render as "<5" in public/suppressed views. 0 disables.
SMALL_NUMBER_THRESHOLD=0

# --- Authentication ---------------------------------------------------------
AUTH_SECRET=dev-only-change-me-32-bytes-minimum
AUTH_TRUST_HOST=true
# Optional OIDC provider; leave blank to use credentials-only.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# --- Import limits ----------------------------------------------------------
IMPORT_MAX_BYTES=26214400
IMPORT_PREVIEW_ROWS=200